# --- Database ---
# Any managed Postgres works (Railway, Supabase, Neon, RDS...).
DATABASE_URL="postgresql://user:password@host:5432/praxis_pms"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Object storage (Supabase Storage) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_STORAGE_BUCKET="your-bucket-name"

# --- Public keys (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="your-bucket-name"