# --- Database ---
# Any managed Postgres works (Railway, Supabase, Neon, RDS...).
DATABASE_URL="postgresql://user:password@host:5432/praxis_pms"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Object storage (Supabase Storage) ---
# From your Supabase dashboard: Project Settings -> API.
# NOTE: Supabase now issues two key formats. If your dashboard shows keys
# starting with "sb_secret_" / "sb_publishable_" (the new format) and you hit
# an "Invalid Compact JWS" error, either upgrade @supabase/supabase-js to the
# latest 2.x (npm install @supabase/supabase-js@latest) or, easier, switch to
# the "Legacy API Keys" tab in Supabase's API settings and use the old
# eyJ...-style anon/service_role JWTs instead — those work with every version.
# SUPABASE_URL is the same "Project URL" your DATABASE_URL's host is based on (e.g. https://xxxx.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (NOT the anon/public key) —
# never expose this to the browser or commit it; it bypasses all Storage RLS, which is why
# this app never needs any Storage RLS policies configured on the bucket at all.
# SUPABASE_STORAGE_BUCKET must be a PRIVATE bucket you've already created in Supabase Storage —
# keep it private; the app only ever hands out short-lived signed URLs after its own
# project-access check, so a public bucket would bypass that access control entirely.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_STORAGE_BUCKET="praxis-pms-files"

# These three are intentionally PUBLIC (NEXT_PUBLIC_ prefix means they ship
# to the browser) — used only so the browser can call Supabase's official
# uploadToSignedUrl() method. They grant no access on their own; every
# upload is authorized by the short-lived signed token from the server
# above, not by the anon key. Use the "anon" / "public" key here, never
# the service_role key.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="praxis-pms-files"
